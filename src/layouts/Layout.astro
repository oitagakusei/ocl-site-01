---
import "../styles/style.scss";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";

const logo = "/assets/images/global/logo.png";
const logoAlt = "Oita Campus Link";

const siteUrl = Astro.site ?? new URL("https://oitacampuslink.com");
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

const {
  title = "産学連携とは違う。学生が社会と共創する機会をつくるNPO｜Oita Campus Link",
  ogType = "website",
  ogTitle = title,
  description = "Oita Campus Linkは、学生自身が運営し意思決定するNPO法人です。従来の産学連携とは異なる形で学生と企業・自治体をつなぎ、対等な共創が生まれる機会をつくることを目的としています。",
  ogDescription = description,
  ogImage = "https://oitacampuslink.com/ogp.png",
  noIndex = false,
  jsonLd = "",
} = Astro.props;
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PN4TSCPX');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl}>

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- favicon -->
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/android-chrome-256x256.png" />

    <!-- ogp -->
    <meta property="og:site_name" content="NPO法人 Oita Campus Link" />
    <meta property="og:url" content={currentUrl}>
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image:src" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Italiana&family=Noto+Serif+JP:wght@700&display=swap"
    />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Italiana&family=Noto+Serif+JP:wght@700&display=swap"
    />

    <!-- Spride -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"
      defer></script>

    <!-- destyle.css（preload+onload） -->
    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/npm/destyle.css@4.0.0/destyle.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/destyle.css@4.0.0/destyle.min.css"
      /></noscript
    >

    <!-- Cloudflare Turnstile -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <!-- JSON-LD -->
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>

  <body id="body">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PN4TSCPX"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Header logo={logo} logoAlt={logoAlt} />

    <slot />

    <Footer logo={logo} logoAlt={logoAlt} />
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
